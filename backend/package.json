{
  "name": "component-formatter-backend",
  "private": true,
  "version": "1.0.0",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node --env-file-if-exists=../.env dist/main.js",
    "dev": "node --env-file-if-exists=../.env node_modules/@nestjs/cli/bin/nest.js start --watch",
    "test": "npm run build && node --test --test-isolation=none test/*.test.cjs"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.0",
    "@nestjs/core": "^11.1.0",
    "@nestjs/platform-express": "^11.1.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.0",
    "@types/node": "^24.0.0",
    "typescript": "^5.9.3"
  }
}
