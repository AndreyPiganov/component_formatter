{
  "name": "component-formatter-backend",
  "private": true,
  "version": "1.0.0",
  "scripts": {
    "build": "npm run prisma:generate && tsc -p tsconfig.json",
    "start": "node --env-file-if-exists=../.env dist/main.js",
    "dev": "npm run prisma:generate && node --env-file-if-exists=../.env node_modules/@nestjs/cli/bin/nest.js start --watch",
    "test": "npm run build && node --test --test-isolation=none test/*.test.cjs",
    "prisma:generate": "prisma generate",
    "prisma:validate": "prisma validate",
    "prisma:migrate": "node --env-file-if-exists=../.env node_modules/prisma/build/index.js migrate deploy"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.0",
    "@nestjs/core": "^11.1.0",
    "@nestjs/platform-express": "^11.1.0",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.0",
    "@types/node": "^24.0.0",
    "prisma": "^7.10.1",
    "typescript": "^5.9.3"
  }
}
