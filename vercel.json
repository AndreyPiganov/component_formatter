{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "web": {
      "root": "frontend",
      "framework": "vite"
    },
    "api": {
      "root": "backend",
      "framework": "nestjs",
      "entrypoint": "src/main.ts",
      "installCommand": "npm ci && npm run prisma:generate"
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": { "service": "api" } },
    { "source": "/(.*)", "destination": { "service": "web" } }
  ]
}